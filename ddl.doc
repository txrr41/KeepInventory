-- Drop table

-- DROP TABLE public.bens;

CREATE TABLE public.bens (
	id serial4 NOT NULL,
	nome varchar NULL,
	tipo varchar NULL,
	situacao varchar NULL,
	data_aquisicao date NULL,
	valor_aquisicao float8 NOT NULL,
	valor_atual float8 NOT NULL,
	quantidade int4 NOT NULL,
	numero_serie varchar NULL,
	modelo varchar NULL,
	CONSTRAINT bens_pkey PRIMARY KEY (id),
	CONSTRAINT bens_status_check CHECK (((situacao)::text = ANY ((ARRAY['ativo'::character varying, 'inativo'::character varying, 'em_manutencao'::character varying])::text[])))
);


-- public.empresas definição

-- Drop table

-- DROP TABLE public.empresas;

CREATE TABLE public.empresas (
	id serial4 NOT NULL,
	cnpj varchar NULL,
	nome_fantasia varchar NULL,
	razao_social varchar(30) NOT NULL,
	telefone varchar NOT NULL,
	cep varchar NOT NULL,
	rua varchar NOT NULL,
	numero int4 NOT NULL,
	bairro varchar NOT NULL,
	cidade varchar NOT NULL,
	estado varchar NOT NULL,
	ativo bool DEFAULT true NOT NULL,
	CONSTRAINT empresas_pkey PRIMARY KEY (id)
);


-- public.logs definição

-- Drop table

-- DROP TABLE public.logs;

CREATE TABLE public.logs (
	id serial4 NOT NULL,
	usuario varchar(100) NOT NULL,
	acao text NOT NULL,
	modulo varchar(100) NULL,
	datahora timestamp DEFAULT CURRENT_TIMESTAMP NULL,
	CONSTRAINT logs_pkey PRIMARY KEY (id)
);


-- public.permissoes definição

-- Drop table

-- DROP TABLE public.permissoes;

CREATE TABLE public.permissoes (
	id serial4 NOT NULL,
	tipo varchar NULL,
	CONSTRAINT permissoes_pkey PRIMARY KEY (id)
);


-- public.usuarios definição

-- Drop table

-- DROP TABLE public.usuarios;

CREATE TABLE public.usuarios (
	id serial4 NOT NULL,
	nome varchar NULL,
	senha varchar NULL,
	CONSTRAINT usuarios_pkey PRIMARY KEY (id)
);


-- public.emprestimos definição

-- Drop table

-- DROP TABLE public.emprestimos;

CREATE TABLE public.emprestimos (
	id serial4 NOT NULL,
	fk_id_bens int4 NULL,
	fk_id_usuarios int4 NULL,
	data_devolucao date NULL,
	status_devolucao varchar NULL,
	CONSTRAINT emprestimos_pkey PRIMARY KEY (id),
	CONSTRAINT emprestimos_status_devolucao_check CHECK (((status_devolucao)::text = ANY ((ARRAY['pendente'::character varying, 'devolvido'::character varying])::text[]))),
	CONSTRAINT emprestimos_fk_id_bens_fkey FOREIGN KEY (fk_id_bens) REFERENCES public.bens(id),
	CONSTRAINT emprestimos_fk_id_usuarios_fkey FOREIGN KEY (fk_id_usuarios) REFERENCES public.usuarios(id)
);


-- public.permissoes_usuarios definição

-- Drop table

-- DROP TABLE public.permissoes_usuarios;

CREATE TABLE public.permissoes_usuarios (
	id serial4 NOT NULL,
	fk_id_usuario int4 NULL,
	fk_id_permissoes int4 NULL,
	CONSTRAINT permissoes_usuarios_pkey PRIMARY KEY (id),
	CONSTRAINT permissoes_usuarios_fk_id_permissoes_fkey FOREIGN KEY (fk_id_permissoes) REFERENCES public.permissoes(id),
	CONSTRAINT permissoes_usuarios_fk_id_usuario_fkey FOREIGN KEY (fk_id_usuario) REFERENCES public.usuarios(id)
);


-- public.predios definição

-- Drop table

-- DROP TABLE public.predios;

CREATE TABLE public.predios (
	id serial4 NOT NULL,
	fk_id_empresas int4 NULL,
	rua varchar NULL,
	numero int4 NULL,
	cep varchar NOT NULL,
	telefone varchar NULL,
	nome varchar NOT NULL,
	situacao varchar NOT NULL,
	ativo bool DEFAULT true NOT NULL,
	bairro varchar NOT NULL,
	estado varchar NOT NULL,
	cidade varchar NOT NULL,
	CONSTRAINT predios_pkey PRIMARY KEY (id),
	CONSTRAINT predios_fk_id_empresas_fkey FOREIGN KEY (fk_id_empresas) REFERENCES public.empresas(id)
);


-- public.salas definição

-- Drop table

-- DROP TABLE public.salas;

CREATE TABLE public.salas (
	id serial4 NOT NULL,
	fk_id_predios int4 NULL,
	nome varchar NULL,
	situacao varchar(11) NOT NULL,
	tipo varchar(11) NOT NULL,
	observacao varchar(40) NULL,
	ativo bool DEFAULT true NOT NULL,
	CONSTRAINT salas_pkey PRIMARY KEY (id),
	CONSTRAINT salas_fk_id_predios_fkey FOREIGN KEY (fk_id_predios) REFERENCES public.predios(id)
);


-- public.patrimonios definição

-- Drop table

-- DROP TABLE public.patrimonios;

CREATE TABLE public.patrimonios (
	id serial4 NOT NULL -- Identificador único do patrimônio,
	nome varchar(200) NOT NULL -- Nome/descrição do bem patrimonial,
	tipo varchar(100) NOT NULL -- Tipo/categoria do patrimônio (ex: Móvel, Equipamento, Eletrônico),
	situacao varchar(50) NOT NULL -- Situação atual do bem (ex: Em Uso, Disponível, Em Manutenção),
	modelo varchar(150) NULL -- Modelo do equipamento/bem,
	valor_aquisicao numeric(10, 2) DEFAULT 0.00 NOT NULL -- Valor pago na aquisição do bem,
	valor_atual numeric(10, 2) DEFAULT 0.00 NOT NULL -- Valor atual/depreciado do bem,
	quantidade int4 DEFAULT 1 NOT NULL -- Quantidade de itens deste patrimônio,
	data_aquisicao date NOT NULL -- Data em que o bem foi adquirido,
	numero_serie varchar(100) NULL -- Número de série ou código do fabricante,
	fk_id_salas int4 NOT NULL -- Referência para a sala onde o bem está localizado,
	ativo bool DEFAULT true NOT NULL -- Indica se o patrimônio está ativo (true) ou foi excluído logicamente (false),
	created_at timestamp DEFAULT CURRENT_TIMESTAMP NULL,
	updated_at timestamp DEFAULT CURRENT_TIMESTAMP NULL,
	CONSTRAINT patrimonios_pkey PRIMARY KEY (id),
	CONSTRAINT fk_patrimonio_sala FOREIGN KEY (fk_id_salas) REFERENCES public.salas(id) ON DELETE RESTRICT ON UPDATE CASCADE
);
CREATE INDEX idx_patrimonios_ativo ON public.patrimonios USING btree (ativo);
CREATE INDEX idx_patrimonios_nome ON public.patrimonios USING btree (nome);
CREATE INDEX idx_patrimonios_numero_serie ON public.patrimonios USING btree (numero_serie);
CREATE INDEX idx_patrimonios_sala ON public.patrimonios USING btree (fk_id_salas);
CREATE INDEX idx_patrimonios_situacao ON public.patrimonios USING btree (situacao);
CREATE INDEX idx_patrimonios_tipo ON public.patrimonios USING btree (tipo);
COMMENT ON TABLE public.patrimonios IS 'Tabela para armazenar os bens patrimoniais da empresa';

-- Column comments

COMMENT ON COLUMN public.patrimonios.id IS 'Identificador único do patrimônio';
COMMENT ON COLUMN public.patrimonios.nome IS 'Nome/descrição do bem patrimonial';
COMMENT ON COLUMN public.patrimonios.tipo IS 'Tipo/categoria do patrimônio (ex: Móvel, Equipamento, Eletrônico)';
COMMENT ON COLUMN public.patrimonios.situacao IS 'Situação atual do bem (ex: Em Uso, Disponível, Em Manutenção)';
COMMENT ON COLUMN public.patrimonios.modelo IS 'Modelo do equipamento/bem';
COMMENT ON COLUMN public.patrimonios.valor_aquisicao IS 'Valor pago na aquisição do bem';
COMMENT ON COLUMN public.patrimonios.valor_atual IS 'Valor atual/depreciado do bem';
COMMENT ON COLUMN public.patrimonios.quantidade IS 'Quantidade de itens deste patrimônio';
COMMENT ON COLUMN public.patrimonios.data_aquisicao IS 'Data em que o bem foi adquirido';
COMMENT ON COLUMN public.patrimonios.numero_serie IS 'Número de série ou código do fabricante';
COMMENT ON COLUMN public.patrimonios.fk_id_salas IS 'Referência para a sala onde o bem está localizado';
COMMENT ON COLUMN public.patrimonios.ativo IS 'Indica se o patrimônio está ativo (true) ou foi excluído logicamente (false)';

-- Table Triggers

CREATE TRIGGER trigger_update_patrimonios_updated_at BEFORE
UPDATE
    ON
    public.patrimonios FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();


-- public.movimentacoes definição

-- Drop table

-- DROP TABLE public.movimentacoes;

CREATE TABLE public.movimentacoes (
	id serial4 NOT NULL,
	fk_id_origem int4 NULL,
	fk_id_destino int4 NULL,
	data_movimentacao date NULL,
	fk_id_usuarios int4 NULL,
	observacoes varchar NULL,
	quantidade int8 NULL,
	status varchar NOT NULL,
	ativo bool DEFAULT true NOT NULL,
	fk_id_patrimonios int4 NULL,
	CONSTRAINT movimentacoes_pkey PRIMARY KEY (id),
	CONSTRAINT movimentacoes_fk_id_destino_fkey FOREIGN KEY (fk_id_destino) REFERENCES public.salas(id),
	CONSTRAINT movimentacoes_fk_id_origem_fkey FOREIGN KEY (fk_id_origem) REFERENCES public.salas(id),
	CONSTRAINT movimentacoes_fk_id_usuarios_fkey FOREIGN KEY (fk_id_usuarios) REFERENCES public.usuarios(id),
	CONSTRAINT movimentacoes_patrimonios_fk FOREIGN KEY (fk_id_patrimonios) REFERENCES public.patrimonios(id)
);



-- DROP FUNCTION public.update_updated_at_column();

CREATE OR REPLACE FUNCTION public.update_updated_at_column()
 RETURNS trigger
 LANGUAGE plpgsql
AS $function$
BEGIN
    NEW.updated_at = CURRENT_TIMESTAMP;
    RETURN NEW;
END;
$function$
;